def check_love_score():
    print("--- The Ultimate Love Meter ---")
    score = 0
    
    # Question 1
    print("\n1. How often does she text or call you first?")
    print("A) All the time")
    print("B) Sometimes, when she's free")
    print("C) Rarely / Only when she needs something")
    q1 = input("Your answer (A/B/C): ").upper()
    if q1 == 'A': score += 35
    elif q1 == 'B': score += 20
    else: score += 5

    # Question 2
    print("\n2. Does she remember the small details you tell her?")
    print("A) Yes, she remembers everything!")
    print("B) Sometimes she forgets, but she tries")
    print("C) Not at all")
    q2 = input("Your answer (A/B/C): ").upper()
    if q2 == 'A': score += 35
    elif q2 == 'B': score += 15
    else: score += 0

    # Question 3
    print("\n3. How does she act when you are having a rough day?")
    print("A) She drops everything to cheer me up or listen")
    print("B) She sends a supportive text")
    print("C) She seems indifferent or distant")
    q3 = input("Your answer (A/B/C): ").upper()
    if q3 == 'A': score += 30
    elif q3 == 'B': score += 15
    else: score += 0

    # Final Rating Calculation
    print("\n==============================")
    print(f"Your Total Love Score: {score}%")
    
    if score >= 80:
        print("Rating: ❤️❤️❤️❤️❤️ (She is head over heels for you!)")
    elif score >= 50:
        print("Rating: ❤️❤️❤️ (There is definitely a strong spark here.)")
    else:
        print("Rating: 💔 (It might be one-sided, or she needs space.)")
    print("==============================")

# Run the program
check_love_score()
